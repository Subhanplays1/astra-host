DISCORD_TOKEN=
ADMIN_IDS=1210291131301101618
ADMIN_ROLE_ID=1376177459870961694
DATABASE_PATH=vexdeploy.db
LXD_NETWORK=vexdeploy
LXD_CLI=
LXD_STORAGE=
DEFAULT_OS_IMAGE=ubuntu:22.04
MAX_CONTAINERS=100
MAX_VPS_PER_USER=3
DEFAULT_MEMORY_MB=1024
DEFAULT_CPUS=1
DEFAULT_DISK_GB=10
# Plans: name:memory_mb:cpus:disk_gb[:badge[:price]]  (comma-separated)
PLANS=Starter:1024:1:10:Free,Pro:2048:2:25:Popular:$4,Business:4096:4:50:Best

# AI (Google Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Mention-chat: anyone can @mention the bot (per-user cooldown seconds)
AI_CHAT_ENABLED=1
AI_CHAT_COOLDOWN=30
AI_CHAT_TIMEOUT=25
# Verification: DM questions + trust report after VPS creation (report-only)
AI_VERIFICATION_ENABLED=1
VERIFICATION_TIMEOUT=600
# Trust role names (auto-created if missing; needs Manage Roles)
TRUSTED_ROLE_NAME=Trusted
UNTRUSTED_ROLE_NAME=Untrusted
SCAMMER_ROLE_NAME=Scammer
SPAMMER_ROLE_NAME=Spammer

# ── Astra Host admin panel (admin-only, never expose publicly) ──
# 1) ADMIN_PANEL_ENABLED=1
# 2) /admin login in Discord  -> one-time code
# 3) open the panel URL from the "Admin Panel" button (DM only) and paste the code
ADMIN_PANEL_ENABLED=0
ADMIN_PANEL_HOST=127.0.0.1
ADMIN_PANEL_PORT=8787
ADMIN_PANEL_SESSION_HOURS=8
ADMIN_PANEL_LOGIN_TTL=300
ADMIN_PANEL_RATE_LIMIT=10
ADMIN_PANEL_DEBUG=0

# ── Admin panel tunnel: local | localhost.run | cloudflare | tailscale | custom ──
# "local" keeps the panel on loopback (recommended: SSH port-forward to reach it).
# Public exposure (free, no account) — uncomment and keep the panel on 8080:
#   ADMIN_PANEL_PORT=8080
#   TUNNEL_PROVIDER=localhost.run
#   TUNNEL_LOCALHOSTRUN=ssh -R 80:localhost:{port} nokey@localhost.run
TUNNEL_PROVIDER=local
TUNNEL_LOCALHOSTRUN=ssh -R 80:localhost:{port} nokey@localhost.run
TUNNEL_CLOUDFLARE=
TUNNEL_TAILSCALE=
TUNNEL_CUSTOM_COMMAND=
TUNNEL_URL_PATTERN=

# ── Discord presence / Astra status messages ──
PRESENCE_INTERVAL_MIN=15
ASTRA_STATUS_INTERVAL_MIN=10
ASTRA_MESSAGES_ENABLED=1
